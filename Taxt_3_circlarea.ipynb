      "source": [
        "class Circle:\n",
        "\n",
        "    def __init__(self, radius,pi=3.14):\n",
        "        self.radius = radius\n",
        "        self.pi = pi\n",
        "\n",
        "    def area(self):\n",
        "        area= self.pi * (self.radius **2)\n",
        "        return area\n",
        "\n",
        "\n",
        "\n",
        "c1 = Circle(5)\n",
        "\n",
        "print(\"Area =\", c1.area())\n",
        "print(\"radius=\",c1.radius)"
      ],
